<Window x:Class="Mitschreibprogramm.Views.UnsavedChangesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ungespeicherte Änderungen" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}" TextElement.Foreground="{DynamicResource ChromeTextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Message" MaxWidth="380" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Speichern" MinWidth="90" Padding="8,4" IsDefault="True" Click="OnSaveClick"/>
            <Button x:Name="DiscardButton" Content="Verwerfen" MinWidth="90" Padding="8,4" Margin="8,0,0,0" Click="OnDiscardClick"/>
            <Button x:Name="CancelButton" Content="Abbrechen" MinWidth="90" Padding="8,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
