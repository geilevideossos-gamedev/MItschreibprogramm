<Window x:Class="Mitschreibprogramm.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}" TextElement.Foreground="{DynamicResource ChromeTextBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="Message" MaxWidth="380" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ConfirmButton" Style="{StaticResource DialogButton}" IsDefault="True" Click="OnConfirmClick"/>
            <Button x:Name="CancelButton" Style="{StaticResource DialogButton}" Content="Abbrechen" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
