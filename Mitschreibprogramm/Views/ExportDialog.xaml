<Window x:Class="Mitschreibprogramm.Views.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Als PDF exportieren" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ChromeBrush}" TextElement.Foreground="{DynamicResource ChromeTextBrush}">
    <StackPanel Margin="20" MinWidth="320">
        <TextBlock Text="A4-Seiten, Striche als Vektoren, Schwarz auf Weiß." TextWrapping="Wrap"/>
        <CheckBox x:Name="RuleLinesCheck" Content="Hintergrundlinien mit exportieren" IsChecked="True" Margin="0,14,0,0"
                  Foreground="{DynamicResource ChromeTextBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ExportButton" Content="Exportieren" MinWidth="90" Padding="8,4" IsDefault="True" Click="OnExportClick"/>
            <Button x:Name="CancelExportButton" Content="Abbrechen" MinWidth="90" Padding="8,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
